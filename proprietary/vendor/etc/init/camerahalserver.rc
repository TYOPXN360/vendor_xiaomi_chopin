# CCU is the camera co-processor the AE/statistics pipeline can hand work to.
# CcuMgr::_checkCcuEnable() reads this once, when the manager is created, and
# with it unset CcuMemMgr never builds its memory pool: allocateCcuBuffer()
# reports totalSize(0) and the driver later walks into a NULL log buffer.
on early-init
    setprop vendor.debug.ccu_mgr_ccu.enable 1

service camerahalserver /vendor/bin/hw/camerahalserver
    class main
    user cameraserver
    group audio camera input drmrpc sdcard_rw system media graphics
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity MaxPerformance

on boot
    chmod 0666 /sys/kernel/fpsgo/common/force_onoff
    # The cpuset mask for the camera background group used to be written here
    # as "write /dev/cpuset/camera-background/cpus 0-3". /dev/cpuset is not
    # mounted on this device: cpuset is deliberately kept on the cgroup v2
    # default hierarchy, since mounting it on v1 calls rebind_subsystems() and
    # pulls it back out of v2. That write therefore always failed and no such
    # group exists anywhere in the tree, so it has been removed rather than
    # left behind as configuration that cannot work. Per-state CPU masks are
    # applied by libprocessgroup instead - see the CpusetCpus attribute in
    # /vendor/etc/task_profiles.json. camerahalserver picks its mask up through
    # "task_profiles CameraServiceCapacity MaxPerformance" above.
